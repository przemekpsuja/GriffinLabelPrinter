## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# dotenv environment variables file
.env

# Others
~$*
*~
CodeCoverage/

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# ==========================================
# VISUAL STUDIO EXTENSIONS
# ==========================================

# Visual Studio cache and options directory (Crucial!)
.vs/

# User-specific files (window positions, open tabs, local paths)
*.user
*.suo
*.userosscache
*.sln.docstates
*.vbw

# Roslyn compiler cache and VS tool analysis data
*.ide/
*.ntvs_analysis.dat
.ntvs_analysis.dat

# Temporary files generated during WPF project builds
*_wpftmp.csproj
*_wpftmp.vbproj

# VS-specific test results and logs
*.trx
*.coverage
*.coveragexml
_Chutzpah*
MSBuild_Logs/

# Third-party IDE add-ons and tools (e.g., ReSharper, dotCover)
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user
*.dotCover
.axoCover/*
!.axoCover/settings.json

# Publish profiles (may contain sensitive deployment data/credentials)
*.pubxml
*.publishproj
*.azurePubxml
PublishScripts/

# VS Code configuration (in case you or someone else uses it)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets