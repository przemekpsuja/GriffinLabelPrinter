<ui:FluentWindow x:Class="GryfLabelManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:helpers="clr-namespace:GryfLabelManager.Helpers"
        xmlns:models="clr-namespace:GryfLabelManager.Models"
        Title="GryfLabelManager" Height="650" Width="950"
        Icon="pack://application:,,,/Resources/app.ico"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">


    <ui:FluentWindow.Resources>
        <helpers:EnumToVisibilityConverter x:Key="EnumToVisibility"/>
        <helpers:EnumToBooleanConverter x:Key="EnumToBoolean"/>
        <helpers:EnumNotEqualToVisibilityConverter x:Key="EnumNotEqualToVisibility"/>
    </ui:FluentWindow.Resources>

    <Grid Margin="20,0,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0: pasek tytułu -->
            <RowDefinition Height="Auto"/>
            <!-- 1: przełącznik trybu -->
            <RowDefinition Height="2*"/>
            <!-- 2: główna zawartość (dokumenty/towary) -->
            <RowDefinition Height="Auto"/>
            <!-- 3: przycisk "Dodaj zaznaczone" / panel ręcznego wpisu -->
            <RowDefinition Height="1*"/>
            <!-- 4: kolejka do wydruku -->
            <RowDefinition Height="Auto"/>
            <!-- 5: przycisk DRUKUJ -->
        </Grid.RowDefinitions>

<ui:TitleBar Grid.Row="0" Title="GryfLabelManager" Padding="0">
    <ui:TitleBar.Icon>
        <ui:ImageIcon Source="pack://application:,,,/Resources/app.ico" 
                      Margin="0,0,8,0" />
    </ui:TitleBar.Icon>
</ui:TitleBar>

        <!-- ============ PRZEŁĄCZNIK TRYBU ============ -->
        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <ui:Button DockPanel.Dock="Right" Content="⟳ Odśwież" Appearance="Primary" Padding="10,5"
                    Command="{Binding RefreshCommand}"
                    Visibility="{Binding CurrentMode, Converter={StaticResource EnumNotEqualToVisibility}, ConverterParameter=Reczny}"/>

            <StackPanel Orientation="Horizontal">
                <RadioButton Content="Dokumenty PZ/PW" GroupName="Tryb" Padding="10,5" Margin="0,0,8,0"
                             IsChecked="{Binding CurrentMode, Converter={StaticResource EnumToBoolean}, ConverterParameter=Dokumenty}"
                             Command="{Binding SwitchModeCommand}" CommandParameter="{x:Static models:ViewMode.Dokumenty}"/>
                <RadioButton Content="Wszystkie towary" GroupName="Tryb" Padding="10,5" Margin="0,0,8,0"
                             IsChecked="{Binding CurrentMode, Converter={StaticResource EnumToBoolean}, ConverterParameter=WszystkieTowary}"
                             Command="{Binding SwitchModeCommand}" CommandParameter="{x:Static models:ViewMode.WszystkieTowary}"/>
                <RadioButton Content="Ręczny wpis" GroupName="Tryb" Padding="10,5"
                             IsChecked="{Binding CurrentMode, Converter={StaticResource EnumToBoolean}, ConverterParameter=Reczny}"
                             Command="{Binding SwitchModeCommand}" CommandParameter="{x:Static models:ViewMode.Reczny}"/>
            </StackPanel>
        </DockPanel>

        <!-- ============ TREŚĆ GŁÓWNA ============ -->
        <Grid Grid.Row="2"
              Visibility="{Binding CurrentMode, Converter={StaticResource EnumNotEqualToVisibility}, ConverterParameter=Reczny}">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- wyszukiwarka -->
                <RowDefinition Height="*"/>
                <!-- lista/siatka -->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <!-- lista dokumentów pojawia się tylko w trybie Dokumenty -->
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Wyszukiwarka - tylko tryb Wszystkie towary -->
            <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                       Visibility="{Binding CurrentMode, Converter={StaticResource EnumToVisibility}, ConverterParameter=WszystkieTowary}">
                <TextBlock Text="Szukaj:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ui:TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Szuka po kodzie i nazwie, bez uwzględniania wielkości liter, spacji, czy znaków interpunkcyjnych"/>
            </DockPanel>

            <!-- Lewa kolumna: lista dokumentów PZ/PW (widoczna tylko w trybie Dokumenty) -->
            <Border Grid.Row="1" Grid.Column="0" Width="230" Margin="0,0,10,0" BorderBrush="#DDD" BorderThickness="1"
                    Visibility="{Binding CurrentMode, Converter={StaticResource EnumToVisibility}, ConverterParameter=Dokumenty}">
                <DockPanel>
                    <TextBlock Text="Dokumenty" FontWeight="Bold" Margin="8" DockPanel.Dock="Top"/>
                    <ListBox ItemsSource="{Binding Documents}"
                             SelectedItem="{Binding SelectedDocument, Mode=TwoWay}"/>
                </DockPanel>
            </Border>

            <!-- Wspólna siatka pozycji do druku - ta sama dla wszystkich 3 trybów -->
            <DataGrid Grid.Row="2" Grid.Column="1" ItemsSource="{Binding BrowseItems}" AutoGenerateColumns="False"
                        CanUserAddRows="False" CanUserDeleteRows="False"
                        RowBackground="White" RowHeight="36" AlternatingRowBackground="#F5F5F5" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Drukuj" Width="55">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!-- Zwykły CheckBox, nie kolumna edycyjna -> zaznacza się już przy 1. kliknięciu -->
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Kod" Binding="{Binding Kod}" Width="150" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Nazwa" Binding="{Binding Nazwa}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Ilość" Binding="{Binding Ilosc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Przycisk pod górną siatką (widoczny w Dokumenty / WszystkieTowary) -->
        <ui:Button Grid.Row="3" Content="Dodaj zaznaczone do wydruku →" Padding="10,5"
                   Appearance="Primary"
            HorizontalAlignment="Right" Margin="0,8,0,0"
            Command="{Binding DodajZaznaczoneCommand}"
            Visibility="{Binding CurrentMode, Converter={StaticResource EnumNotEqualToVisibility}, ConverterParameter=Reczny}"/>

        <!-- ============ PANEL RĘCZNEGO WPISU (tylko tryb Reczny) ============ -->
        <Border Grid.Row="3" Margin="0,12,0,0" Padding="10" BorderBrush="#DDD" BorderThickness="1"
                Visibility="{Binding CurrentMode, Converter={StaticResource EnumToVisibility}, ConverterParameter=Reczny}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Kod:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ui:TextBox Width="200" Margin="0,0,12,0" Text="{Binding RecznyKod, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Nazwa:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ui:TextBox Width="250" Margin="0,0,12,0" Text="{Binding RecznyNazwa, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Ilość:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ui:NumberBox Width="160" Margin="0,0,12,0" Text="{Binding RecznaIlosc, UpdateSourceTrigger=PropertyChanged}"/>
                <ui:Button Content="Dodaj do listy" Padding="10,4" Appearance="Primary" Command="{Binding DodajRecznieCommand}"/>
            </StackPanel>
        </Border>

        <!-- NOWA sekcja: kolejka do wydruku -->
        <Border Grid.Row="4" Margin="0,12,0,0" BorderBrush="#DDD" BorderThickness="1">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="8">
                    <TextBlock Text="Do wydruku" FontWeight="Bold" VerticalAlignment="Center"/>
                    <ui:Button DockPanel.Dock="Right" Content="Wyczyść listę" Padding="8,4"
                    HorizontalAlignment="Right"
                    Command="{Binding WyczyscKolejkeCommand}"/>
                </DockPanel>
                <DataGrid ItemsSource="{Binding PrintQueue}" AutoGenerateColumns="False"
                    CanUserAddRows="False" CanUserDeleteRows="False" RowHeight="36"
                    RowBackground="White"
                    AlternatingRowBackground="#F5F5F5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Kod" Binding="{Binding Kod}" Width="150" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Nazwa" Binding="{Binding Nazwa}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Ilość" Binding="{Binding Ilosc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                        <DataGridTemplateColumn Header="" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ui:Button Content="Usuń" Padding="4,2" Appearance="Primary"
                            Command="{Binding DataContext.UsunZKolejkiCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- ============ DRUKUJ ============ -->
        <ui:Button Grid.Row="5" Content="DRUKUJ" Appearance="Primary" FontSize="16" FontWeight="Bold" Padding="5"
                Margin="0,12,0,0" HorizontalAlignment="Right"
                Command="{Binding DrukujCommand}" Height="34"/>
    </Grid>
</ui:FluentWindow>